# Supabase (Google auth + data storage)
# Create a project at https://supabase.com, then add the Google provider under
# Authentication > Providers. Set the redirect URL to {APP_URL}/auth/callback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (never NEXT_PUBLIC_ - never exposed to the browser).
# Used by /api/data and /api/account route handlers to write records server-side.
# It bypasses RLS, so it must stay on the server.
SUPABASE_SECRET=

# Public origin of this app (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ImageKit (logo, signature and background pattern images)
# Find these under ImageKit dashboard > Developer options.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
